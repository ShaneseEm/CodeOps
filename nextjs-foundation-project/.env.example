# Database
DATABASE_URL="postgres://postgres:password@localhost:5432/addis_eats"

# Authentication & Session
SERVER_SIGNING_SECRET="addis_eats_server_signing_secret_key_32_bytes_minimum"
JWT_SECRET="addis_eats_jwt_secret_dev"

# Public Client-Exposed Metadata & Findability Base URL
# In local development: http://localhost:3000
# In production: https://addiseats.et
NEXT_PUBLIC_APP_URL="https://addiseats.et"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-ADDIS12345"
