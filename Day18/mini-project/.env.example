# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
# DO NOT commit '.env.local' to git! It is protected by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Private Server-Side Secrets (DO NOT prefix with NEXT_PUBLIC_)
# Strictly private to Node.js / Server Components / Route Handlers.
# ------------------------------------------------------------------------------
DATABASE_URL="postgres://postgres:local_dev_password@localhost:5432/addis_eats"
SERVER_SIGNING_SECRET="e9b2f4c3a1789201bd7482910c2847291a837492c81729384719283746192837"
JWT_SECRET="addis_eats_jwt_dev_secret_key_2026"

# Telebirr Payment Gateway Server API Keys
TELEBIRR_APP_ID="1000028"
TELEBIRR_APP_KEY="tb_app_key_private_server_only"
TELEBIRR_PUBLIC_KEY="MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC3..."
