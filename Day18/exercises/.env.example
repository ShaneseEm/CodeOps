# ==============================================================================
# Addis Eats - Environment Variable Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local':
#    cp .env.example .env.local
# 2. Fill in the required secrets for your local environment.
# 3. DO NOT commit '.env.local' to git (it is protected by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Secrets (STRICTLY PRIVATE - Never prefix with NEXT_PUBLIC_)
# Accessible ONLY in Server Components, Route Handlers, and Server Actions.
# ------------------------------------------------------------------------------
DATABASE_URL="postgres://postgres:local_dev_password@localhost:5432/addis_eats_dev"
SERVER_SIGNING_SECRET="dev_server_secret_replace_in_production_with_64_char_hex"
JWT_SECRET="dev_jwt_secret_change_me_before_deploying_to_vercel"

# Telebirr Payment Gateway Integration (Server-to-Server API)
TELEBIRR_APP_ID="100000123"
TELEBIRR_APP_KEY="tb_live_secret_never_expose_to_client_bundle"
TELEBIRR_PUBLIC_KEY="MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC..."
TELEBIRR_SHORTCODE="88219"

# Redis Cache & Session Store
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="redis_dev_password_only"

# ------------------------------------------------------------------------------
# 2. Client-Exposed Variables (PREFIXED WITH NEXT_PUBLIC_)
# CAUTION: These values ARE bundled into the public JavaScript downloaded by users!
# Only put public domain URLs or client-safe telemetry identifiers here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-ADDIS12345"
NEXT_PUBLIC_CURRENCY_SYMBOL="ETB"
NEXT_PUBLIC_SUPPORT_EMAIL="support@addiseats.et"
